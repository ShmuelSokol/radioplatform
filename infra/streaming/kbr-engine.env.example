# /etc/kbr-engine/env — read by kbr-engine.service. setup.sh writes the real file.
# Never commit real values: this repository is public.

# Backend API base, including /api/v1
KBR_BACKEND_URL=https://api.kbrlive.com/api/v1
# The one station this engine plays (same value as PLAYOUT_ENGINE_STATION_ID on the backend)
KBR_STATION_ID=
# Shared secret, sent both ways in X-Playout-Token (same value as PLAYOUT_ENGINE_TOKEN on the backend)
KBR_PLAYOUT_TOKEN=
# Control endpoints listen on 127.0.0.1 only; nginx puts TLS in front at /control/
KBR_CONTROL_PORT=8081
# Files played if the backend cannot be reached (drop a few hours of safe music here)
KBR_EMERGENCY_DIR=/var/lib/kbr-engine/emergency
KBR_ICECAST_HOST=127.0.0.1
KBR_ICECAST_PORT=8000
KBR_ICECAST_SOURCE_PASSWORD=
KBR_ICECAST_MOUNT=/live
# Length of the quick fade when Next is pressed or a timed item takes over
KBR_SKIP_FADE_SECONDS=0.5
