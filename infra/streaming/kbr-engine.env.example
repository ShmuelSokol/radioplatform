# Settings for kbr-engine@<station id>.service. setup.sh writes the real files: the shared
# ones in /etc/kbr-engine/env, the station's own (marked below) in /etc/kbr-engine/stations/<id>.env.
# Never commit real values: this repository is public.

# Backend API base, including /api/v1
KBR_BACKEND_URL=https://api.kbrlive.com/api/v1
# [station] The station this engine plays (one of PLAYOUT_ENGINE_STATION_ID on the backend)
KBR_STATION_ID=
# Shared secret, sent both ways in X-Playout-Token (same value as PLAYOUT_ENGINE_TOKEN on the backend)
KBR_PLAYOUT_TOKEN=
# Control endpoints listen on 127.0.0.1 only; nginx puts TLS in front at /control/
# [station] 8081, 8082, ... one per engine
KBR_CONTROL_PORT=8081
# Files played if the backend cannot be reached (drop a few hours of safe music here)
KBR_EMERGENCY_DIR=/var/lib/kbr-engine/emergency
KBR_ICECAST_HOST=127.0.0.1
KBR_ICECAST_PORT=8000
KBR_ICECAST_SOURCE_PASSWORD=
# [station] /live-<station id>
KBR_ICECAST_MOUNT=/live-
# [station] Where the HLS copy for iPhone Safari is written (nginx serves /hls/<id>/); empty = none
KBR_HLS_DIR=/var/lib/kbr-engine/hls/
# Length of the quick fade when Next is pressed or a timed item takes over
KBR_SKIP_FADE_SECONDS=0.5
# [station] The sound on air: broadcast (leveler, three-band compressor, limiter at -1.5 dBFS)
# or light (default; the chain before 2026-11-19: compressor -14 dB 3:1, limiter -3 dBFS).
# setup.sh writes it from KBR_BROADCAST_SOUND
KBR_PROCESSING=light
# The leveler's target loudness (dB RMS); -14 gives about -14 LUFS on music
KBR_PROCESSING_TARGET=-14
