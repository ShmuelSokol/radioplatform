[Unit]
Description=KBR Live playout engine (Liquidsoap) for station %i
After=network-online.target icecast2.service
Wants=network-online.target
Requires=icecast2.service

[Service]
Type=simple
User=liquidsoap
Group=liquidsoap
# Shared settings, then this station's own (id, control port, mount)
EnvironmentFile=/etc/kbr-engine/env
EnvironmentFile=/etc/kbr-engine/stations/%i.env
ExecStart=/usr/bin/liquidsoap /etc/kbr-engine/radio.liq
Restart=always
RestartSec=3
# Audio must not be starved by anything else on the machine
Nice=-10
LimitNOFILE=65536
# A runaway engine is stopped at this size and started again, before the whole server
# runs out of memory (2026-11-20: two engines, no swap, load 26, SSH unreachable, the
# kernel killed an engine at ~300 MB). Normal use is well below.
MemoryMax=450M
# Asked last by the kernel's out-of-memory killer, after anything else on the box
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
