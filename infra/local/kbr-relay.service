[Unit]
Description=KBR Live local relay (keeps the FM box on air without internet)
# setup-box.sh orders the engine after this (kbr-engine@.service.d/box.conf)
After=network.target

[Service]
EnvironmentFile=/etc/kbr-engine/relay.env
ExecStart=/usr/bin/python3 /opt/kbr-engine/kbr_relay.py
Restart=always
RestartSec=2
User=liquidsoap

[Install]
WantedBy=multi-user.target
