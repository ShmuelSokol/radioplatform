# Settings for kbr-relay.service on a local FM box (see wiki/local-fm-box.md).
# Never commit real values: this repository is public.

# The website's backend, including /api/v1
KBR_UPSTREAM_URL=https://api.kbrlive.com/api/v1
# The station this box plays, and the same shared secret as the engine
KBR_STATION_ID=
KBR_PLAYOUT_TOKEN=
# The engine on this box must use  KBR_BACKEND_URL=http://127.0.0.1:8090/api/v1
KBR_RELAY_PORT=8090
# The engine's control port on this box
KBR_ENGINE_CONTROL=http://127.0.0.1:8081
# Plan, library copy and kept start reports (the library needs the disk space)
KBR_RELAY_DIR=/var/lib/kbr-local
# offline = hand timed items to the engine only while the backend is unreachable;
# always = the backend cannot reach this engine at all
KBR_RELAY_TIMED=offline
# 0 = copy only the audio of the next two days, not the whole library
KBR_RELAY_MIRROR_LIBRARY=1

# ── For the ENGINE on this box (its own env file, not the relay's) ──
# The sound card that feeds the transmitter, as `aplay -L` names it (needs alsa-utils).
# Empty = no sound card output. A missing card never stops the stream; the engine
# restarts once when the card is back (see wiki/local-fm-box.md).
#   KBR_ALSA_DEVICE=default
